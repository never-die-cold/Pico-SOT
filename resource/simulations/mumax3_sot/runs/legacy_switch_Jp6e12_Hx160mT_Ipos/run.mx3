// ============================================================================
// mumax3：皮秒电脉冲驱动 PMA Co 膜的 SOT 动力学与确定性翻转
// 复现：Jhuria, Hohlfeld, ... Gorchon,
//      "Spin-orbit torque switching of a ferromagnet with picosecond
//       electrical pulses", Nature Electronics 3, 680-686 (2020)
//      doi:10.1038/s41928-020-00488-3
//
// 器件：Ta(5)/Pt(4)/Co(1)/Cu(1)/Ta(4)/Pt(1) nm（Co 为垂直磁化层）
// 论文参数：Ha ~ 1 T（FMR 半周期 ~20 ps），theta_DL = 0.20，theta_FL = 0.05
//           时间分辨脉冲 3.7 ps (sech^2)，翻转实验脉冲 6 ps
//           Hx = ±160 mT，翻转阈值 dV ~ 40 V，Jc(ps) ~ 6e12 A/m^2（上限）
//
// 两个关键单位/接口约定（旧脚本在此翻车）：
//  1) Ku1 = Keff + mu0*Ms^2/2，其中 Keff = mu0*Ms*Ha/2 = Ms*Ha_T/2
//     例：Ms=1.3e6 A/m, Ha=1 T -> Keff=6.5e5 J/m^3, Ku1=1.71e6 J/m^3
//  2) mumax3 的 Slonczewski 核只读取 J 的 z 分量（源码 cuda/slonczewski2.cu），
//     所以面内电流的 SOT 必须用 J = vector(0,0,J_eff) 编码：
//        FixedLayer = (0,1,0)  即自旋极化 sigma 沿 y
//        Pol = 0.20 (= theta_DL), EpsilonPrime = 0.05 (= theta_FL), Lambda = 1
//        Lambda=1 时 Slonczewski 效率 eps = Pol/2，正好等于标准自旋霍尔因子
//     Xi 只作用于 Zhang-Li 转矩，与 SOT 无关；本题关闭 Zhang-Li。
//
// 极性标定（本脚本实测，与论文 Fig.3 一致）：
//        J_eff = -I_sign * |J|,   I_sign=+1 代表论文中的 +I
//        (Hx>0, +I) 平行  -> 最终 -Mz ;  (Hx>0, -I) 反平行 -> +Mz
//        一般规律：mz_final 的符号 = -sign(Hx * I)
// ============================================================================

// ============================ 用户参数区 ====================================
RunDynamics := 0     // 0: 单个 6 ps 脉冲翻转；1: 低电流 3.7 ps 时域响应
CaseName    := "switch"
I_sign  := 1         // 电流极性（论文 convention）：+1 或 -1
InitMz  := 1         // 初始态：+1 (up) 或 -1 (down)
Hx_mT   := 160       // 面内辅助场 (mT)
Jp      := 6e12      // 电流密度峰值 (A/m^2)。switch 用 ~6e12-1.2e13；dynamics 用 ~3e11-3e12
Heating := 1         // 1: 打开焦耳加热(T(t) 模型)；0: 纯 LLG
dT_ref  := 300       // 在 J_ref 持续功率下的稳态温升 (K)；Heating=0 时忽略
J_ref   := 6e12      // 加热参考电流密度 (A/m^2)：dT ∝ (J/J_ref)^2
tau_cool := 100e-12  // 冷却时间常数 (s)
t_free  := 400e-12   // 脉冲后自由演化时间 (s)
// 快速测试网格 64x64(0.32um x 0.32um)，宏观自旋近似；
// 全器件 5um x 4um 可改 1024x800（慢，用于成核/畴壁研究）
// ============================================================================

// ------------------------------ 网格 ---------------------------------------
Nx := 64
Ny := 64
SetGridSize(Nx, Ny, 1)
SetCellSize(5e-9, 5e-9, 1e-9)
// 全器件：SetGridSize(1024,800,1) + SetCellSize(5e-9,5e-9,1e-9)

// ---------------------------- 材料参数 -------------------------------------
Ms_val := 1.3e6               // Co 饱和磁化 (A/m)
Msat   = Ms_val
Aex    = 3e-11                // 交换常数 (J/m)，Pt/Co 典型值
alpha  = 0.15                 // 有效阻尼（论文表观 >0.2 含非均匀展宽）
Ha_T   := 1.0                 // 垂直各向异性场 (T)
Keff   := 0.5*Ms_val*Ha_T               // = mu0*Ms*Ha/2 = 6.5e5 J/m^3
Ku1_0  := Keff + 0.5*mu0*Ms_val*Ms_val  // 总单轴各向异性 = 1.71e6 J/m^3
Ku1    = Ku1_0
AnisU  = vector(0, 0, 1)      // 垂直易轴

// ------------------------------ SOT ----------------------------------------
FixedLayer   = vector(0, 1, 0)   // sigma 沿 y（面内电流沿 x 的自旋极化方向）
Pol          = 0.20              // theta_DL
EpsilonPrime = 0.05              // theta_FL
Lambda       = 1
DisableZhangLiTorque = true
FreeLayerThickness = 1e-9        // 若 z 网格不是 1 nm，必须显式给出 Co 厚度

// ---------------------------- 面内场 / 脉冲 --------------------------------
Hx := Hx_mT*1e-3
B_ext = vector(Hx, 0, 0)

tp     := 0.0
stp    := 0.0
t_pre  := 0.0
t_post := 0.0
if RunDynamics == 1 {
    CaseName = "dynamics"
    tp = 3.7e-12                 // FWHM，时间分辨实验
    stp = 0.1e-12
    t_pre = -4*tp
    t_post = 4*tp
} else {
    tp = 6e-12                   // FWHM，翻转实验
    stp = 0.2e-12
    t_pre = -4*tp
    t_post = 4*tp
}

// ------------------------- 加热模型参数（Heating=1） ------------------------
// 焦耳功率 ∝ J^2 -> q(t) = (J/J_ref)^2，经一阶低通( tau_cool )得到 h_th；
// T(t) = T_amb + dT_ref * h_th/H_peak，H_peak = 0.756*tp/tau_cool，
// 使峰值 J=J_ref 的脉冲结束时恰好升到 T_amb+dT_ref，之后 exp 冷却。
// Ms(T), Ku(T) 用简化标度律（论文 SI 同思路，可自行替换）：
Tc_K    := 800.0                 // 论文估计 Tc ~ 800 K
T_amb   := 300.0
beta_cc := 0.34                  // Ms(T)/Ms0 = ((Tc-T)/(Tc-T0))^beta
n_ku    := 3.0                   // Ku(T)/Ku0 = (Ms(T)/Ms0)^n
H_peak  := 0.756*tp/tau_cool

J_cur := 0.0                     // 当前电流密度（供表格记录）
h_th  := 0.0                     // 归一化热历史（一阶低通滤波）
fM    := 1.0                     // Ms(T)/Ms0

// ------------------------------ 输出 ---------------------------------------
OutputFormat = OVF2_BINARY
TableAutoSave(stp/2)
TableAdd(E_total)
TableAddVar(J_cur + 0.0, "J", "A/m2")
TableAddVar(T_amb + dT_ref*h_th/H_peak, "T", "K")
// autosave(m, 5e-12)             // 需要看畴结构/成核时打开

// ------------------------------ 初始弛豫 -----------------------------------
m = Uniform(0, 0, InitMz)
J_cur = 0.0
J = vector(0, 0, 0)
relax()
saveas(m, "m_initial")
print("Case=", CaseName, " I_sign=", I_sign, " InitMz=", InitMz, " Hx(mT)=", Hx_mT)
print("relax mz =", m.average().Z())

// ------------------------------ 皮秒脉冲 -----------------------------------
// sech^2(1.763*t/tp)，FWHM = tp；J_eff = -I_sign*|J|（见文件头极性标定）
for ti := t_pre; ti <= t_post; ti += stp {
    x  := 1.763*ti/tp
    ex := exp(x)
    s2 := 4 / ((ex + 1/ex)*(ex + 1/ex))

    J_cur = -I_sign*Jp*s2
    J = vector(0, 0, J_cur)

    if Heating == 1 {
        decay := exp(-stp/tau_cool)
        q := (J_cur/J_ref)*(J_cur/J_ref)     // 焦耳功率（归一化）
        h_th = h_th*decay + q*(1-decay)
        T_now := T_amb + dT_ref*h_th/H_peak
        fM = pow((Tc_K - T_now)/(Tc_K - T_amb), beta_cc)
        Msat = Ms_val*fM
        Ku1  = Ku1_0*pow(fM, n_ku)      // 热各向异性转矩来源：Ha(T) 随温升下降
    }
    run(stp)
}

// ------------------------------ 脉冲后自由演化 -----------------------------
J_cur = 0.0
J = vector(0, 0, 0)
dtrun := 10e-12
nfree := t_free/dtrun
for k := 0; k < nfree; k++ {
    if Heating == 1 {
        h_th = h_th*exp(-dtrun/tau_cool)
        T_now := T_amb + dT_ref*h_th/H_peak
        fM = pow((Tc_K - T_now)/(Tc_K - T_amb), beta_cc)
        Msat = Ms_val*fM
        Ku1  = Ku1_0*pow(fM, n_ku)
    }
    run(dtrun)
}

saveas(m, "m_final")
mzavg := m.average().Z()
print("mz after pulse =", mzavg)

if RunDynamics == 0 {
    if InitMz > 0 {
        if mzavg < -0.5 {
            print("结果：翻转 up -> down")
        } else {
            print("结果：未翻转（可增大 Jp / dT_ref，或调整 Hx / I_sign）")
        }
    } else {
        if mzavg > 0.5 {
            print("结果：翻转 down -> up")
        } else {
            print("结果：未翻转（可增大 Jp / dT_ref，或调整 Hx / I_sign）")
        }
    }
}
