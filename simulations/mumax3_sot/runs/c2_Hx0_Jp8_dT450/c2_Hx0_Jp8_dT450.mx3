// ============================================================================
// Fast 64x64 macrospin variant of the Fig. 3 switching experiment (time-exact)
//
// Paper: Jhuria et al., Nature Electronics 3, 680-686 (2020)
//        doi:10.1038/s41928-020-00488-3
//
// IMPORTANT (fixed 2026-09-15): the earlier version of this script drove the
// pulse from the loop counter and used the default adaptive solver, so the
// "6 ps" pulse was stretched to ~27.6 ps in real time (dt ~ 1 ps per run(0.2ps)).
// Here the pulse is a function of the built-in time t and the solver uses a
// fixed step, so the pulse is exactly 6 ps (or 3.7 ps in dynamics mode).
//
// Physics / interfaces (verified):
//   * SOT = Slonczewski emulation: Pol=theta_DL=0.20, EpsilonPrime=theta_FL=0.05,
//     Lambda=1, FixedLayer=(0,1,0)=sigma, J along z (kernel reads J.z only).
//   * J_eff = -I_sign*|J|: (Hx>0, I_sign=+1) is the paper's "parallel"
//     configuration -> final -Mz; in general sign(mz_final) = -sign(Hx*I).
//   * Ku1 = Keff + mu0*Ms^2/2 with Keff = 0.5*Ms*Ha[T] (Ha in tesla).
//   * Heating: first-order low-pass of (J/J_ref)^2, normalised so that a pulse
//     with peak J=J_ref ends at T_amb + dT_ref (tau_cool = cooling time).
//     Ms(T) = Ms0*((Tc-T)/(Tc-T0))^0.34 ; Ku(T) = Ku0*(Ms(T)/Ms0)^KuExp.
//   * Grid 64x64 x 5 nm = 320x320 nm (macrospin-like, fast). Full device:
//     SetGridSize(1024,800,1) + SetCellSize(5e-9,5e-9,1e-9) (slow).
//
// Use with run_case.py, e.g.:
//   python run_case.py macrospin_switch.mx3 b1_Jp8e12 --set Jp=8e12 dT_ref=300
//   python run_case.py macrospin_switch.mx3 b2_theta0  --set Pol=0.0001 EpsilonPrime=0
//   python run_case.py macrospin_switch.mx3 b3_noKuT   --set KuExp=0
// ============================================================================

// ============================ 用户参数区 ====================================
RunDynamics := 0     // 0: single 6 ps pulse switching; 1: low-current 3.7 ps dynamics
CaseName    := "switch"
I_sign  := 1         // current polarity (paper convention): +1 or -1
InitMz  := 1         // initial state: +1 (up) or -1 (down)
Hx_mT   := 0       // in-plane bias field (mT)
Jp      := 8e12      // peak current density (A/m^2)
Heating := 1         // 1: Joule heating model; 0: pure LLG
dT_ref  := 450       // steady temperature rise at J_ref (K); ignored if Heating=0
J_ref   := 8e12      // heating reference current density (A/m^2): dT ~ (J/J_ref)^2
tau_cool := 100e-12  // cooling time constant (s)
t_free  := 400e-12   // free evolution after the pulse (s)
KuExp   := 3.0       // Ku(T) = Ku0*(Ms(T)/Ms0)^KuExp. 0 = no Ku(T) scaling
// ============================================================================

// ------------------------------ mesh ----------------------------------------
Nx := 64
Ny := 64
SetGridSize(Nx, Ny, 1)
SetCellSize(5e-9, 5e-9, 1e-9)

// ---------------------------- material --------------------------------------
Ms_val := 1.3e6
Msat   = Ms_val
Aex    = 3e-11
alpha  = 0.15                 // effective damping (paper: apparent >0.2)
Ha_T   := 1.0                 // PMA field (T)
Keff   := 0.5*Ms_val*Ha_T
Ku1_0  := Keff + 0.5*mu0*Ms_val*Ms_val
Ku1    = Ku1_0
AnisU  = vector(0, 0, 1)

// ------------------------------ SOT -----------------------------------------
FixedLayer   = vector(0, 1, 0)   // sigma along y
Pol          = 0.20              // theta_DL
EpsilonPrime = 0.05              // theta_FL
Lambda       = 1
DisableZhangLiTorque = true
FreeLayerThickness = 1e-9

// ---------------------------- field / pulse ---------------------------------
Hx := Hx_mT*1e-3
B_ext = vector(Hx, 0, 0)

tp     := 0.0
stp    := 0.0
if RunDynamics == 1 {
    CaseName = "dynamics"
    tp = 3.7e-12
    stp = 0.1e-12
} else {
    tp = 6e-12
    stp = 0.2e-12
}
t0p := 4*tp                   // pulse centre (s), 4*FWHM after t=0

// ------------------------- heating model parameters -------------------------
Tc_K    := 800.0
T_amb   := 300.0
beta_cc := 0.34
H_peak  := 0.756*tp/tau_cool

J_cur := 0.0
h_th  := 0.0
fM    := 1.0

// ---------------- accurate, reproducible time stepping ----------------------
SetSolver(4)                  // classical RK4 with fixed step
FixDt = 5e-14                 // 0.05 ps

// ------------------------------ output --------------------------------------
OutputFormat = OVF2_BINARY
TableAutoSave(stp/2)
TableAdd(E_total)
TableAddVar(J_cur + 0.0, "J", "A/m2")
TableAddVar(T_amb + dT_ref*h_th/H_peak, "T", "K")

// ------------------------------ relaxation ----------------------------------
m = Uniform(0, 0, InitMz)
J_cur = 0.0
J = vector(0, 0, 0)
relax()
saveas(m, "m_initial")
print("Case=", CaseName, " I_sign=", I_sign, " InitMz=", InitMz, " Hx(mT)=", Hx_mT)
print("relax mz =", m.average().Z())

// ---------------- pulse as a function of the real time t --------------------
// sech^2(1.763*(t-t0p)/tp), FWHM = tp, exactly in real time
J = vector(0, 0, -I_sign*Jp*4/((exp(1.763*(t-t0p)/tp)+exp(-1.763*(t-t0p)/tp))*(exp(1.763*(t-t0p)/tp)+exp(-1.763*(t-t0p)/tp))))

// ------------------------------ pulse loop ----------------------------------
tprev := 0.0
for ti := 0.0; ti < 8*tp + stp; ti += stp {
    tb := t
    ex := exp(1.763*(tb-t0p)/tp)
    s2 := 4/((ex + 1/ex)*(ex + 1/ex))
    J_cur = -I_sign*Jp*s2
    dtr := tb - tprev
    if Heating == 1 {
        decay := exp(-dtr/tau_cool)
        q := (J_cur/J_ref)*(J_cur/J_ref)
        h_th = h_th*decay + q*(1-decay)
        T_now := T_amb + dT_ref*h_th/H_peak
        fr := (Tc_K - T_now)/(Tc_K - T_amb)
        fr = 0.5*(fr + abs(fr))          // clamp at 0 (T <= Tc)
        fM = pow(fr, beta_cc)
        Msat = Ms_val*fM
        Ku1  = Ku1_0*pow(fM, KuExp)
    }
    tprev = tb
    run(stp)
}

// ------------------------------ free evolution ------------------------------
J = vector(0, 0, 0)
J_cur = 0.0
dtrun := 10e-12
nfree := t_free/dtrun
for k := 0; k < nfree; k++ {
    tb := t
    dtr := tb - tprev
    if Heating == 1 {
        decay := exp(-dtr/tau_cool)
        h_th = h_th*decay
        T_now := T_amb + dT_ref*h_th/H_peak
        fr := (Tc_K - T_now)/(Tc_K - T_amb)
        fr = 0.5*(fr + abs(fr))          // clamp at 0 (T <= Tc)
        fM = pow(fr, beta_cc)
        Msat = Ms_val*fM
        Ku1  = Ku1_0*pow(fM, KuExp)
    }
    tprev = tb
    run(dtrun)
}

saveas(m, "m_final")
mzavg := m.average().Z()
print("mz after pulse =", mzavg)

if RunDynamics == 0 {
    if InitMz*mzavg < -0.5 {
        print("result: switched")
    } else {
        print("result: NOT switched (raise Jp / dT_ref, check Hx / I_sign)")
    }
}
