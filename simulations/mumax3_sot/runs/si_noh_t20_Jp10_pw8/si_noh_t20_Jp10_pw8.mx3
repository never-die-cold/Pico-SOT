// ============================================================================
// Fast 64x64 macrospin variant of the Fig. 3 switching experiment (time-exact)
//
// Paper: Jhuria et al., Nature Electronics 3, 680-686 (2020)
//        doi:10.1038/s41928-020-00488-3
//
// SI REPLICA (2026-09): this script now follows the Supplementary Information
// (Supplementary Note 3, Table S1) instead of the guessed legacy parameters:
//   * Ms(300 K) = 1.0e6 A/m, B_K(300 K) = 0.8 T  (Kz = 1e6 J/m3), alpha = 0.23
//   * Ms(T) = Ms(0)*[1-(T/Tc)^1.7], Kz(T) = Kz(0)*(Ms(T)/Ms(0))^3, Tc = 800 K
//   * Ku1 = Kz (not Keff + mu0*Ms^2/2): matches H_z = 2Kz/(mu0 Ms) - Ms exactly
//   * heating = 0D equivalent channel of the SI 1D heat-diffusion model
//     (heat_model.py): C dT/dt = rho*J^2 - C*T/tau, tau = C*d/G_int.
//     At 6e12 / 6 ps this gives +50 K peak (SI: ~60 K), NOT the legacy 300 K.
//   * Pol = theta_DL (0.20 main-text fit; 0.30 in SI Fig. 3-5), EpsilonPrime =
//     theta_FL = 0.05, Lambda = 1.  Verified against cuda/slonczewski2.cu and
//     the SI LLG: dm/dt|DL = gamma (hbar/2e) Pol J/(Ms t) m x (m x sigma).
//
// Legacy outputs used free knobs dT_ref=300-600 K and tau_cool=100 ps and are
// kept as model=legacy in runs/summary.csv; new runs should use model=si.
//
// Use with run_case.py, e.g.:
//   python run_case.py macrospin_switch.mx3 si_b1_Jp6 --set Jp=6e12
//   python run_case.py macrospin_switch.mx3 si_c0_noh_8e12 --set Jp=8e12 Heating=0
//   python run_case.py macrospin_switch.mx3 si_pw20 --set tp_ps=20
// ============================================================================

// ============================ 用户参数区 ====================================
RunDynamics := 0     // 0: single-pulse switching; 1: low-current dynamics mode
CaseName    := "switch"
I_sign  := 1         // current polarity (paper convention): +1 or -1
InitMz  := 1         // initial state: +1 (up) or -1 (down)
Hx_mT   := 160       // in-plane bias field (mT)
Jp      := 10e12      // peak current density (A/m^2)
Heating := 0         // 1: SI heat channel; 0: frozen 300 K
Noise   := 0         // 1: Langevin noise at T_now; 0: deterministic
ScaleMs := 1         // 1: Ms(T) per SI; 0: freeze Ms at 300 K
ScaleKz := 1         // 1: Kz(T) per SI; 0: freeze Kz at 300 K
ThetaDL := 0.2      // spin Hall angle (0.20 fit; 0.30 in SI Fig. 3-5)
tp_ps   := 8       // pulse FWHM (ps); dynamics mode typically 3.7
t_free  := 400e-12   // free evolution after the pulse (s)
// ============================================================================

// ------------------------------ mesh ----------------------------------------
Nx := 64
Ny := 64
SetGridSize(Nx, Ny, 1)
SetCellSize(5e-9, 5e-9, 1e-9)

// ------------------- SI material parameters (Table S1) ----------------------
Ms300  := 1.0e6                  // A/m at 300 K (VSM)
BK300  := 0.8                    // T, PMA anisotropy field at 300 K (fit)
Kz300  := 0.5*Ms300*(BK300 + mu0*Ms300)  // = 1.03e6 J/m3 (2Kz/Ms - mu0 Ms = BK)
alpha  = 0.23                    // effective damping (SI fit from TR-MOKE)
Tc_K   := 800.0                  // K
T_amb  := 300.0                  // K
fr300  := 1.0 - pow(T_amb/Tc_K, 1.7)
Ms0    := Ms300/fr300            // Ms(0) = 1.23e6 A/m
Kz0    := Kz300/pow(fr300, 3.0)  // Kz(0) = 1.87e6 J/m3

Msat   = Ms300                   // NOTE: mumax3 default Msat is 0!
Aex    = 3e-11
Ku1    = Kz300
AnisU  = vector(0, 0, 1)

// ------------------------------ SOT -----------------------------------------
FixedLayer   = vector(0, 1, 0)   // sigma along y
Pol          = ThetaDL           // theta_DL
EpsilonPrime = 0.05              // theta_FL
Lambda       = 1
DisableZhangLiTorque = true
FreeLayerThickness = 1e-9

// ---------------------------- field / pulse ---------------------------------
Hx := Hx_mT*1e-3
B_ext = vector(Hx, 0, 0)

tp := tp_ps*1e-12
if RunDynamics == 1 {
    CaseName = "dynamics"
}
stp := 0.2e-12
t0p := 4*tp                      // pulse centre (s)

// --------------- SI heat channel (heat_model.py calibration) ----------------
rho_e    := 81e-8                // Ohm m (SI four-point measurement)
C_vol    := 2.6e6                // J/m3/K (SI weighted average)
G_int    := 170e6                // W/m2/K (SI fit, sapphire)
d_stack  := 16e-9                // m
tau_cool := C_vol*d_stack/G_int  // 245 ps = C*d/G

J_cur := 0.0
Tdev  := 0.0                     // T - T_amb (K)

// ---------------- accurate, reproducible time stepping ----------------------
SetSolver(4)                  // classical RK4 with fixed step
FixDt = 5e-14                 // 0.05 ps

// ------------------------------ output --------------------------------------
OutputFormat = OVF2_BINARY
TableAutoSave(stp/2)
TableAdd(E_total)
TableAddVar(J_cur + 0.0, "J", "A/m2")
TableAddVar(T_amb + Tdev, "T", "K")

// ------------------------------ relaxation ----------------------------------
m = Uniform(0, 0, InitMz)
J_cur = 0.0
J = vector(0, 0, 0)
relax()
saveas(m, "m_initial")
print("Case=", CaseName, " I_sign=", I_sign, " InitMz=", InitMz, " Hx(mT)=", Hx_mT)
print("relax mz =", m.average().Z())

// ---------------- pulse as a function of the real time t --------------------
// sech^2(1.763*(t-t0p)/tp), FWHM = tp, exactly in real time
J = vector(0, 0, -I_sign*Jp*4/((exp(1.763*(t-t0p)/tp)+exp(-1.763*(t-t0p)/tp))*(exp(1.763*(t-t0p)/tp)+exp(-1.763*(t-t0p)/tp))))

// ------------------------------ pulse loop ----------------------------------
tprev := 0.0
for ti := 0.0; ti < 8*tp + stp; ti += stp {
    tb := t
    ex := exp(1.763*(tb-t0p)/tp)
    s2 := 4/((ex + 1/ex)*(ex + 1/ex))
    J_cur = -I_sign*Jp*s2
    dtr := tb - tprev
    if Heating == 1 {
        decay := exp(-dtr/tau_cool)
        src := rho_e*J_cur*J_cur/C_vol
        Tdev = Tdev*decay + src*tau_cool*(1.0-decay)
        T_now := T_amb + Tdev
        fr := 1.0 - pow(T_now/Tc_K, 1.7)
        fr = 0.5*(fr + abs(fr))          // clamp at 0 (T >= Tc -> Ms = 0)
        if ScaleMs == 1 {
            Msat = Ms0*fr
        } else {
            Msat = Ms300
        }
        if ScaleKz == 1 {
            Ku1 = Kz0*pow(fr, 3.0)
        } else {
            Ku1 = Kz300
        }
    }
    if Noise == 1 {
        Temp = T_amb + Tdev
    }
    tprev = tb
    run(stp)
}

// ------------------------------ free evolution ------------------------------
J = vector(0, 0, 0)
J_cur = 0.0
dtrun := 10e-12
nfree := t_free/dtrun
for k := 0; k < nfree; k++ {
    tb := t
    dtr := tb - tprev
    if Heating == 1 {
        decay := exp(-dtr/tau_cool)
        Tdev = Tdev*decay
        T_now := T_amb + Tdev
        fr := 1.0 - pow(T_now/Tc_K, 1.7)
        fr = 0.5*(fr + abs(fr))
        if ScaleMs == 1 {
            Msat = Ms0*fr
        } else {
            Msat = Ms300
        }
        if ScaleKz == 1 {
            Ku1 = Kz0*pow(fr, 3.0)
        } else {
            Ku1 = Kz300
        }
    }
    if Noise == 1 {
        Temp = T_amb + Tdev
    }
    tprev = tb
    run(dtrun)
}

saveas(m, "m_final")
mzavg := m.average().Z()
print("mz after pulse =", mzavg)

if RunDynamics == 0 {
    if InitMz*mzavg < -0.5 {
        print("result: switched")
    } else {
        print("result: NOT switched (raise Jp / ThetaDL, check Hx / I_sign)")
    }
}
